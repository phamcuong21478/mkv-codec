# -----------------------------------------------------------------------------
# vb_mkv KAT waveform tests -- Vivado xsim
#
#   make list                       list the configurations
#   make run     CFG=<cfg>          compile, elaborate and simulate one configuration, dump waves
#   make gui     CFG=<cfg>          run the same simulation live in the xsim GUI with the wave layout
#   make wave    CFG=<cfg>          open the saved wave database of a finished run in the xsim GUI
#   make regress                    run every configuration and print a PASS/FAIL summary
#   make clean                      remove build/
#
# Options:
#   WAVE=wdb|vcd|both|none          waveform dump of `make run` (default wdb -> build/<cfg>/wave.wdb)
#   XILINX_VIVADO=<install dir>     Vivado install to use (default: xvlog/xelab/xsim from PATH,
#                                   e.g. after `source <Vivado>/settings64.sh`)
# -----------------------------------------------------------------------------
SHELL := /bin/bash

TB_DIR  := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
RTL_DIR := $(TB_DIR)/../rtl
BUILD   := $(TB_DIR)/build

CFG  ?= t128_tcvn_int
WAVE ?= wdb

ifneq ($(XILINX_VIVADO),)
  XBIN := $(XILINX_VIVADO)/bin/
endif
XVLOG := $(XBIN)xvlog
XELAB := $(XBIN)xelab
XSIM  := $(XBIN)xsim

RTL_SRCS := $(sort $(wildcard $(RTL_DIR)/*.v)) $(sort $(wildcard $(RTL_DIR)/lib/*.v))
TB_SRCS  := $(TB_DIR)/tb_mkv_kat.sv
TB_INCS  := $(TB_DIR)/mkv_kat_vectors.vh

# -----------------------------------------------------------------------------
# Configurations: BLOCK DIR TARGET SBOX_IMPL PROFILE KEY_SCHED RKS_IMPL DEC_ARCH RS_LV
#   t128 = engine T, a128 = engine A, t256 = engine T256, a256 = engine A256
# -----------------------------------------------------------------------------
t128_tcvn_int            := 128 BOTH FPGA BRAM  TCVN2024 INT FF    JDOM 0
t128_tcvn_ext            := 128 BOTH FPGA BRAM  TCVN2024 EXT FF    JDOM 0
t128_ietf_int            := 128 BOTH FPGA BRAM  IETF2026 INT FF    JDOM 0
t128_tcvn_int_enc        := 128 ENC  FPGA BRAM  TCVN2024 INT FF    JDOM 0
a128_tcvn_int_asic       := 128 BOTH ASIC LOGIC TCVN2024 INT FF    JDOM 0
a128_tcvn_ext_asic_latch := 128 BOTH ASIC LOGIC TCVN2024 EXT LATCH JDOM 0
a128_ietf_int_fpga_rs1   := 128 BOTH FPGA LOGIC IETF2026 INT FF    JDOM 1
t256_tcvn_int            := 256 BOTH FPGA BRAM  TCVN2024 INT FF    JDOM 0
t256_tcvn_ext            := 256 BOTH FPGA BRAM  TCVN2024 EXT FF    JDOM 0
t256_ietf_int            := 256 BOTH FPGA BRAM  IETF2026 INT FF    JDOM 0
a256_tcvn_int_jdom       := 256 BOTH ASIC LOGIC TCVN2024 INT FF    JDOM 0
a256_tcvn_ext_sep_latch  := 256 BOTH ASIC LOGIC TCVN2024 EXT LATCH SEP  0
a256_ietf_ext_jdom_macro := 256 BOTH ASIC LOGIC IETF2026 EXT MACRO JDOM 0
a256_tcvn_int_jdom_dec   := 256 DEC  ASIC LOGIC TCVN2024 INT FF    JDOM 0

CFGS := t128_tcvn_int t128_tcvn_ext t128_ietf_int t128_tcvn_int_enc \
        a128_tcvn_int_asic a128_tcvn_ext_asic_latch a128_ietf_int_fpga_rs1 \
        t256_tcvn_int t256_tcvn_ext t256_ietf_int \
        a256_tcvn_int_jdom a256_tcvn_ext_sep_latch a256_ietf_ext_jdom_macro a256_tcvn_int_jdom_dec

P := $($(CFG))
ifeq ($(strip $(P)),)
  $(error Unknown CFG '$(CFG)'. Run `make list`)
endif
B := $(BUILD)/$(CFG)

.PHONY: help list run compile sim gui wave regress clean

help:
	@sed -n '2,17p' $(lastword $(MAKEFILE_LIST)) | sed 's/^# \{0,1\}//'

list:
	@printf '%-26s %-5s %-4s %-6s %-5s %-8s %-3s %-5s %-4s %s\n' \
	    CFG BLOCK DIR TARGET SBOX PROFILE KS RKS DEC RS_LV
	@$(foreach c,$(CFGS),printf '%-26s %-5s %-4s %-6s %-5s %-8s %-3s %-5s %-4s %s\n' $(c) $($(c));)

# ---- build: per-configuration tb_cfg.vh, compile, elaborate ----
$(B)/tb_cfg.vh: FORCE
	@mkdir -p $(B)
	@printf '%s\n' \
	    '// generated by tb/Makefile for CFG=$(CFG)' \
	    '`define CFG_BLOCK     $(word 1,$(P))' \
	    '`define CFG_DIR       "$(word 2,$(P))"' \
	    '`define CFG_TARGET    "$(word 3,$(P))"' \
	    '`define CFG_SBOX_IMPL "$(word 4,$(P))"' \
	    '`define CFG_PROFILE   "$(word 5,$(P))"' \
	    '`define CFG_KEY_SCHED "$(word 6,$(P))"' \
	    '`define CFG_RKS_IMPL  "$(word 7,$(P))"' \
	    '`define CFG_DEC_ARCH  "$(word 8,$(P))"' \
	    '`define CFG_RS_LV     $(word 9,$(P))' > $@.tmp
	@cmp -s $@.tmp $@ && rm -f $@.tmp || mv -f $@.tmp $@

$(B)/xsim.dir/snap/xsimk: $(B)/tb_cfg.vh $(RTL_SRCS) $(TB_SRCS) $(TB_INCS)
	@echo "== [$(CFG)] compile + elaborate"
	@cd $(B) && $(XVLOG) --log xvlog_rtl.log $(RTL_SRCS) > /dev/null
	@cd $(B) && $(XVLOG) --log xvlog_tb.log --sv -i $(B) -i $(TB_DIR) $(TB_SRCS) > /dev/null
	@cd $(B) && $(XELAB) --log xelab.log --timescale 1ns/1ps --debug typical -s snap tb_mkv_kat > /dev/null

compile: $(B)/xsim.dir/snap/xsimk

# ---- simulate in batch with waveform dump ----
run sim: compile
	@echo "== [$(CFG)] simulate (WAVE=$(WAVE))"
	@rm -f $(B)/wave.wdb $(B)/wave.vcd
	@cd $(B) && TB_WAVE=$(WAVE) $(XSIM) snap --log sim.log \
	    $(if $(filter wdb both,$(WAVE)),--wdb wave.wdb) --tclbatch $(TB_DIR)/scripts/xsim_run.tcl > /dev/null
	@grep -vE '^(INFO|#|\*\*\*\*|  \*\*\*\*|Vivado Simulator|Time resolution|source |run all|quit|exit|Copyright|Running|Tool Version|Start of session|Using|WARNING: \[Simtcl 6-197\]|\$$finish called|$$)' $(B)/sim.log || true
	@for f in wave.wdb wave.vcd; do [ -f $(B)/$$f ] && echo "== waveform: $(B)/$$f"; done; true
	@grep -q '^\[FINISH\] PASS' $(B)/sim.log

# ---- GUI ----
gui: compile
	cd $(B) && $(XSIM) snap --gui --log sim_gui.log --tclbatch $(TB_DIR)/scripts/gui_run.tcl

wave:
	@[ -f $(B)/wave.wdb ] || { echo "No $(B)/wave.wdb: run 'make run CFG=$(CFG)' first"; exit 1; }
	cd $(B) && $(XSIM) --gui wave.wdb --tclbatch $(TB_DIR)/scripts/wave_view.tcl

# ---- all configurations ----
regress:
	@mkdir -p $(BUILD); rm -f $(BUILD)/regress.txt; fail=0; \
	for c in $(CFGS); do \
	    if $(MAKE) --no-print-directory run CFG=$$c WAVE=$(WAVE) > $(BUILD)/regress_$$c.log 2>&1; \
	    then r=PASS; else r=FAIL; fail=1; fi; \
	    printf '%-26s %s\n' $$c $$r | tee -a $(BUILD)/regress.txt; \
	done; \
	echo "summary: $$(grep -c PASS $(BUILD)/regress.txt) PASS / $$(grep -c FAIL $(BUILD)/regress.txt) FAIL"; \
	exit $$fail

clean:
	rm -rf $(BUILD)

FORCE:
